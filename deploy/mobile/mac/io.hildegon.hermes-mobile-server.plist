<plist version="1.0"><dict>
  <key>Label</key><string>io.hildegon.hermes-mobile-server</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=/Users/sergio/.config/hermes-mobile/server.env</string>
